<Window x:Class="Paperwork.Shell.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:Paperwork.Data"
        xmlns:shell="clr-namespace:Paperwork.Shell"
        Title="Paperwork"
        Width="524" Height="374"
        MinWidth="320" MinHeight="240"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei"
        FontSize="12">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <!-- 调色板本身在 App.xaml 的应用级资源里，由 Themes/Palette.Apply 覆盖。
         这里只放非颜色的常量，避免窗口级资源把动态主题挡住。
         圆角 PanelRadius 也放在应用级——右键菜单要用同一个值。 -->
    <!-- 颜色以外的常量（字体、圆角）一律放 App.xaml：重命名对话框是另一个 Window，
         窗口级资源它取不到。以前 BookFont / MonoFont 放在这里。 -->

    <!-- 滚动条按 ui-mock.html 的 .scroll::-webkit-scrollbar 来：7px 宽、无轨道底色、
         无上下箭头；滑块左右各让 1px 纸色（净宽 5px）的胶囊，悬停换 AccentLine。
         3px 那版太细，用户点名加宽到 5。隐式样式，所以首页磁贴区和设置页一起换掉。 -->
    <Style x:Key="PaperThumb" TargetType="Thumb">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Background" Value="{DynamicResource Rule}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <!-- 颜色由 ScrollBar 的悬停触发器改 Thumb.Background，这里只跟随。
                 悬停判定不放在 Thumb 上：实测 Thumb 自己的 IsMouseOver 触发器不生效
                 （拖得动、色也对，就是不变），而挂在 ScrollBar 上还能把命中目标
                 从 3px 放宽到整条 7px。 -->
            <Border Margin="1,0" CornerRadius="2.5" Background="{TemplateBinding Background}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PaperPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <!-- 光设 Width 没用：ScrollViewer 模板在 PART_VerticalScrollBar 上直接绑了
           SystemParameters.VerticalScrollBarWidth(17)，模板里的本地值压过 Style 的 Setter。
           Min/MaxWidth 模板没碰，夹住它就真的只有 7px。
           宽度只在匹配方向的 Trigger 里夹，不做跨方向复位——复位要写 MaxWidth="None"，
           而 LengthConverter 只认 "Auto" 不认 "None"，会在样式实例化时抛 FormatException，
           异常被调度器兜住后整个隐式样式静默失效，退回系统默认滚动条（查 error.log 才发现）。 -->
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb x:Name="PaperThumbEl" Style="{StaticResource PaperThumb}"/>
                </Track.Thumb>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource PaperPageButton}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource PaperPageButton}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PaperThumbEl" Property="Background" Value="{DynamicResource AccentLine}"/>
              </Trigger>
              <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="7"/>
                <Setter Property="MinWidth" Value="7"/>
                <Setter Property="MaxWidth" Value="7"/>
              </Trigger>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="7"/>
                <Setter Property="MinHeight" Value="7"/>
                <Setter Property="MaxHeight" Value="7"/>
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- 焦点框必须在这里再压一次。App.xaml 那个全局覆盖（替换 SystemParameters.FocusVisualStyleKey）
           盖不住所有路径：点完 ✕ 之后按 Alt，WPF 仍会给有键盘焦点的元素套上那条虚线矩形。
           这里直接把 FocusVisualStyle 置空，从根上掐掉 —— 三枚图标钮（设置 / 收起 / 设置页退出）共用这个样式。 -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CrumbButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
      <Setter Property="FontFamily" Value="{StaticResource BookFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================ 备忘录 ============================
         规格见 design/memo-mock.html ⑤。几条要点：
         · 横条卡片 = 标题加粗单行省略 + 内容预览 2 行截断 + 右侧时间
         · 悬停走图标按钮同一套语言：AccentSoft 底 + AccentLine 框 + 标题转 Accent
         · 状态只改底色与描边，不改尺寸（§0.1）
         · 图钉只有 Pinned 才显示，由 VM 直接给 Visibility，省掉一个转换器 -->

    <!-- 置顶图钉。stroke 用 1.8 而不是磁贴图形的 1.6：它是 13px 的角标，不是磁贴图形，
         1.6 在这个尺寸下太细。 -->
    <Style x:Key="NotePin" TargetType="Path">
      <Setter Property="Width" Value="13"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
      <Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Data" Value="M 12,20.5 V 14.5  M 7.6,14.5 L 9.2,6.2 H 14.8 L 16.4,14.5 Z  M 9.9,6.2 V 4.3 H 14.1 V 6.2"/>
    </Style>

    <!-- 横条卡片：标题加粗单行省略 + 内容预览 2 行截断 + 右侧时间。
         悬停走图标按钮同一套语言：AccentSoft 底 + AccentLine 框 + 标题转 Accent。
         状态只改底色与描边，不改尺寸（§0.1）。
         图钉的 Visibility 由 VM 直接给，省掉一个 BoolToVisibility 转换器。 -->
    <Style x:Key="NoteCard" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Paper2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9,12,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <DockPanel>
                    <Path Style="{StaticResource NotePin}" VerticalAlignment="Center" Margin="0,0,5,0"
                          Visibility="{Binding PinVisibility}"/>
                    <TextBlock x:Name="tt" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Preview}" FontSize="11" LineHeight="16.5" Margin="0,3,0,0"
                             Foreground="{DynamicResource Ink2}" TextWrapping="Wrap"
                             MaxHeight="33" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="10.5" Margin="10,2,0,0"
                           FontFamily="Cascadia Mono, Consolas, Segoe UI Mono, Microsoft YaHei"
                           Foreground="{DynamicResource Ink3}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
                <Setter TargetName="tt" Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 空态那块可点的虚线提示区（自己的样式，不复用 NoteCard：它没有内容，也不该有底色）。
         描边**不在这里**：WPF 的 Border 画不出虚线，所以外框由内容层那一个 Rectangle 提供
         （见 MemoEmpty）。这里一旦再给 BorderBrush/BorderThickness，就会变成
         "实线圆角框 + 里面一圈虚线"的两条线 —— 实机被用户当场指出过。
         Padding 也不在这里：虚线要贴外框边缘（顶替旧实线），而 Padding 会把内容（连同
         虚线）往内推 24px，虚线就退成"实线套虚线"。间距由内容层自己负责。 -->
    <Style x:Key="NoteEmpty" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14">
              <!-- 双向拉伸都不能省，这两条是三轮实机量出来的：
                   VerticalAlignment 默认拉伸 → 按钮处在 ScrollViewer 里，空态框会被拉成
                   "从列表顶画到面板底"的一整条（实测 611x409，本该约 138px 高）；
                   HorizontalAlignment 默认 Center → 内容不铺满按钮宽度，虚线框缩成
                   "包住图标和文字的小方框"（实测 128x188）。
                   改回 Center 之后框会以内容尺寸居中，和"整块可点"的语义对不上。 -->
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <!-- 悬停只改底色：描边（虚线）的颜色由 Rectangle 自己的样式管，
                   这里再碰 BorderBrush 就又会长出第二条线。 -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 列表下方那行「虚线新建条目」（design/memo-new-row.html 的 V1：居中 + 与「新建备忘」）。
         与空态 NoteEmpty 的关系：**同一支虚线**（1.5px / DashArray "5 4" = 7.5px 段 6px 空）、
         同一种悬停（底 AccentSoft、虚线 AccentLine → Accent），但**圆角 10 跟条目走**——
         它现在是列表里的一行，不是空态那块大提示区。虚线的段长与笔宽不变，
         所以「同一个应用里可点虚线框只有一种画法」这条仍然成立。
         高度由使用处给（52 = 单行条目高度），样式不写死：空态与行两种用法要分开。
         同样**不给 BorderBrush**——WPF 的 Border 画不出虚线，外框由内容层那个 Rectangle
         提供，一旦再给就变成"实线套虚线"（空态踩过，实机被用户当场指出过）。
         双向 Stretch 也不能省（同空态：少一条就会塌成"包住文字的小方框"）。 -->
    <Style x:Key="NoteGhostRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 输入框：标题与内容共用，只有字号/字重不同。
         必须写 Template —— TextBox 的默认模板没有圆角可设，光改 Background/BorderBrush 得不到 10px 圆角。
         内容框的滚动条是 PART_ContentHost 自带的 ScrollViewer，
         因此自动套上窗口级那个隐式 ScrollBar 样式（§4.12），不用另外指定。 -->
    <Style x:Key="NoteField" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Paper2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,8,11,8"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 右下角 FAB：42×42 与图标格同边长、圆角 13 与磁贴同圆角 —— 同一套几何语言。
         right 26 / bottom 40：往左挪离边远一点，同时避开设在 bottom 9–24 的右下斜线。 -->
    <Style x:Key="NoteFab" TargetType="Button">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentOn}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13"
                    RenderTransformOrigin="0.5,0.5">
              <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round"
                    Stretch="Uniform" Width="20" Height="20"
                    Data="M 12,5 V 19  M 5,12 H 19"/>
            </Border>
            <ControlTemplate.Triggers>
              <!-- 位移不能用 TargetName 指向 RenderTransform 里的 TranslateTransform：
                   它的名字注册方式和视觉树元素不同，XAML 编译器报 MC4111。
                   改成整个替换 RenderTransform——触发器失效时会自动回落到基值（null），
                   等价于回到 Y=0。 -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentStrong}"/>
                <Setter TargetName="bd" Property="RenderTransform">
                  <Setter.Value><TranslateTransform Y="-1"/></Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 危险按钮（删除备忘）：平时就是红字红图标，悬停给淡红底 + 红框。
         不能复用 IconButton —— 它的模板 Border 没绑 Padding，
         横向内容会被挤在边框上（就是"选中框太小、挤着文字"的原因）。 -->
    <Style x:Key="NoteDangerButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
      <Setter Property="Padding" Value="10,5,10,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerSoft}"/>
                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Danger}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 置顶用勾选，不是药丸开关（§4.10 没定义复选框，这条要补进手册）：
         16×16 · 圆角 4 · 框 1px Rule · 底 Paper2；勾选 = Accent 底 + AccentOn 钩。
         悬停 = **淡底 + 1px 细框**（AccentSoft + AccentLine），与右边的删除按钮同一套语法、
         同一档粗细，只是色相从危险红换成主题色（B1，2026-10-01，比稿见
         design/memo-pin-hover.html）。原来只有一层 Paper2 底、没有框 —— 纸色上叠纸色
         几乎看不见，唯一线索是那个 16px 小方格，而热区是 67×30 的整块，
         视觉线索比热区小一大截，就是"感觉不好点"的来源。 -->
    <Style x:Key="NoteCheck" TargetType="CheckBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <!-- 可点区域就是这一整条 Border：热区 = 高亮块，30px 高。
                 Padding 是 9,6 而不是 10,7：加了 1px 边框之后，边框要吃掉 1px，
                 不补回来整行会从 30 变成 32 —— 既顶到下面的状态栏，也和删除那个
                 被 Stretch 撑出来的 30 错开 2px（见下面那行的注释）。 -->
            <Border x:Name="row" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="1" CornerRadius="8" Padding="9,6,9,6">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="box" Width="16" Height="16" CornerRadius="4"
                        Background="{DynamicResource Paper2}"
                        BorderBrush="{DynamicResource Rule}" BorderThickness="1">
                  <Path x:Name="tick" Stretch="Uniform" Width="11" Height="11"
                        Stroke="{DynamicResource AccentOn}" StrokeThickness="2.8"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 5,12.5 L 9.5,17 L 19,7" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter x:Name="cp" Margin="7,0,0,0" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <!-- 与删除按钮同一套语法：淡底 + 1px 细框。两个都是主题色加 alpha 派生
                     （AccentSoft 12% / AccentLine 34%，夜空纸 16% / 40%），不写死色值 ——
                     换主题色后必须跟着走，否则蓝主题下悬停会冒出一块绿（D15）。 -->
                <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>

                <!-- 方格**不能再填 AccentSoft**：整块的底已经是它了，填了方格就消失，
                     只剩一圈淡框。改成把框提到 Accent 实色、底维持 Paper2 ——
                     于是三档递进成立：静止 Rule 框 → 悬停 Accent 框 → 选中 Accent 实心 + 钩。 -->
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                <Setter TargetName="cp" Property="TextBlock.Foreground" Value="{DynamicResource Accent}"/>
                <Setter TargetName="cp" Property="TextBlock.FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 设置页里的可选项行。选中态由窗口的 AccentKey / PaperKey / IconKey / AnchorKey 驱动，
         所以点一下只需要改一个字符串，界面自己会动。 -->
    <Style x:Key="OptionRow" TargetType="Border">
      <Setter Property="Padding" Value="10,7,10,7"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- 主题色/纸张的双色 chip（照 design/ui-mock.html 的 .swatch）：50x32 底 + 底部 9px 色带。
         一行三片横排，不再一行一项竖排占掉大半屏。 -->
    <Style x:Key="OptionChip" TargetType="Border">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>

    <!-- 分段控件的按钮。选中态由 RefreshSettingVisuals 上色（主题色实底 + 反白字），
         所以这里只定形状。文字色走 TextElement.Foreground（可继承），标题不要设本地 Foreground。 -->
    <Style x:Key="SegButton" TargetType="Border">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="3,0,0,0"/>
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2}"/>
    </Style>

    <!-- 虚拟描边：收尾磁贴与拖放占位格共用同一组规格，保证两把虚线视觉统一。
         必须用 Rectangle —— WPF 的 Border 画不出虚线，所以之前收尾磁贴那圈其实是
         1.5px 实线，和设计稿写的 dashed 不一致，看着突兀。
         StrokeDashArray 的单位是「几个 StrokeThickness」：要 2.5px 段 / 2.5px 空，
         在 1.5 描边下就是 1.67 1.67。圆角 10.25 = 图标座的 11 减半个笔宽。 -->
    <Style x:Key="GhostRing" TargetType="Rectangle">
      <Setter Property="Stroke" Value="{DynamicResource AccentLine}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeDashArray" Value="1.67 1.67"/>
      <Setter Property="RadiusX" Value="10.25"/>
      <Setter Property="RadiusY" Value="10.25"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- ============================ 磁贴模板 ============================ -->
    <DataTemplate DataType="{x:Type data:TileVm}">
      <Border x:Name="root" Background="Transparent" CornerRadius="13" Padding="4,7,4,6"
              ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="450">
        <Grid HorizontalAlignment="Center">
          <StackPanel HorizontalAlignment="Center">

            <Grid HorizontalAlignment="Center"
                  Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                  Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}">

              <!-- 类型图形统一走 box 内的 presetGlyph（按 Kind/扩展名从 Glyphs 分流），
                   不再用格子外那条 5px 书签凸口：凸口会把文件夹轮廓顶出图标格，视觉上"突兀"。 -->


              <Border x:Name="box" Margin="0,4,0,0" CornerRadius="11" BorderThickness="1"
                      Background="{DynamicResource Paper2}" BorderBrush="{DynamicResource Rule}"
                      SnapsToDevicePixels="True">
                <Grid>
                  <!-- 失效态的虚线框（§5：1px dashed Ink3）。Border 不支持虚线描边，
                       所以单独垫一层 Rectangle（和 CSS 的 inset box-shadow 同位）。
                       原先这里还有一层"选中态内环" selRing —— 选中态改成 S1（只留整卡淡底，
                       内圈一律不动）之后没人再显示它，按"不留死代码"删掉。 -->
                  <Rectangle x:Name="deadRing" Visibility="Collapsed" IsHitTestVisible="False"
                             Margin="1" RadiusX="10" RadiusY="10"
                             Stroke="{DynamicResource Ink3}" StrokeThickness="1" StrokeDashArray="2,2"/>

                  <!-- 落点提示的两圈环，同样垫一层、<b>不碰 BorderThickness</b>：
                       改厚度会让卡片尺寸跳 2px，而拖拽判定天天在读这块磁贴的位置 ——
                       尺寸一跳，判定圆就跟着动，这正是"吸附时抽搐"的反馈环（F 方案）。
                       两档粗细必须分得开（手册 §5 硬约束②）：并入 1.5 / 新建组合 2.5。
                       2026-09-30 第二次调：原 2 / 3 偏重 —— 自从让贴片边与 chip 边
                       在提示态全部让位之后，这圈环成了**唯一的信号**，一个人扛下了全部视觉重量。
                       只减细（颜色仍是实色主题色，不压透明度）。 -->
                  <Rectangle x:Name="dropRing" Visibility="Collapsed" IsHitTestVisible="False"
                             Margin="1" RadiusX="10" RadiusY="10"
                             Stroke="{DynamicResource Accent}" StrokeThickness="1.5"/>
                  <Rectangle x:Name="mergeRing" Visibility="Collapsed" IsHitTestVisible="False"
                             Margin="1" RadiusX="10" RadiusY="10"
                             Stroke="{DynamicResource Accent}" StrokeThickness="2.5"/>

                  <!-- 真图标（Shell / 自定义）：B 方案 —— 贴片只占图标格 80%，裁成圆角 + 发丝描边。
                       用 Rectangle 而不是 Border + Image：WPF 的 Border **不裁子元素的角**，
                       满铺时图标的方角会骑在圆角外；Rectangle 的 Fill 走它自己的圆角几何，
                       天然裁掉四角，顺带省掉 OpacityMask / 在代码里算 Clip 那一套。
                       尺寸也不能再写死 IconSize×IconSize：box 有 1px 描边、内容区只有 IconSize−2，
                       满铺的图底边必然被裁 2px（2026-09-30 修）。 -->
                  <Rectangle x:Name="art" Visibility="Collapsed" IsHitTestVisible="False"
                             RenderOptions.BitmapScalingMode="HighQuality"
                             SnapsToDevicePixels="True"
                             Stroke="{DynamicResource Rule}" StrokeThickness="1"
                             Width="{Binding ArtSize, RelativeSource={RelativeSource AncestorType=Window}}"
                             Height="{Binding ArtSize, RelativeSource={RelativeSource AncestorType=Window}}"
                             RadiusX="{Binding ArtRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                             RadiusY="{Binding ArtRadius, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Rectangle.Fill>
                      <ImageBrush ImageSource="{Binding Icon}" Stretch="Uniform"/>
                    </Rectangle.Fill>
                  </Rectangle>

                  <TextBlock x:Name="glyphText" Text="{Binding DisplayGlyph}"
                             Visibility="{Binding HasGlyphText, Converter={StaticResource BoolVis}}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                             Foreground="{DynamicResource Ink2}"/>

                  <UniformGrid x:Name="mini" Rows="2" Columns="2" Visibility="Collapsed"
                               Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="4" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"/>
                    <Border CornerRadius="4" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Rule}" BorderThickness="1"/>
                    <Border CornerRadius="4" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Rule}" BorderThickness="1"/>
                    <Border CornerRadius="4" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"/>
                  </UniformGrid>

                  <!-- 预设图形：按 Kind 与扩展名从 Glyphs（UI 手册 §6 的图标族）分流——
                       普通文件/文件夹/收尾格/拖放占位**共用这一个元素**，不再各开一个。
                       **必须画在 box 内部**：放在 box 的兄弟节点上会被 box 的底色盖住，
                       表现成"图形糊在底板后面"（上一版就是这个错，像素统计看不出来）。
                       **图形一律 = 图标格 × 50%**：「24 图形 + Margin 12 = 48 设计格 + Viewbox」，
                       三档都精确一半（32→16 / 42→21 / 56→28）。旧写法 Margin=10 是 32→12 / 42→22 / 56→36，
                       三档下从 37% 到 64% 漂移，正是"大小不统一"的来源。 -->
                  <Viewbox Visibility="{Binding HasGlyphData, Converter={StaticResource BoolVis}}" Stretch="Uniform">
                    <Path x:Name="presetArt" Width="24" Height="24" Margin="12" Stretch="Uniform"
                          Stroke="{DynamicResource Ink2}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="{Binding GlyphData}"/>
                  </Viewbox>
                </Grid>
              </Border>

              <!-- 虚线圈在 box 之外，所以内缩和 box 完全一致（Margin 0,4,0,0），
                   换图标档位时两者一起缩放，不会出现圈和框错半像素 -->
              <Rectangle x:Name="ghost" Style="{StaticResource GhostRing}"
                         Margin="0,4,0,0" Visibility="Collapsed"/>

              <!-- 收纳角标（design/badge-corner.html 的 P2 位置 + design/badge-size.html 的 S1 尺寸）。
                   位置：圆心落在 box 右上角 R11 的 45° 对角线上，探出量 e = +2 ——
                   即右缘比 box 右缘外推 2px、顶比 box 顶上抬 2px，所以 Margin 是负的。
                   挂在这里（图标格）而不是磁贴外层 Grid：外层 Grid 的宽度跟着标签
                   长短浮动，角标会跟着漂，长标签上能飞出去十几像素；图标格是固定的
                   IconSize × IconSize，e 才是定值。
                   探出之后圆点同时压在 Paper 与 Paper2 两种底色上，所以加 1.5px
                   Paper2 描边把两色隔开（描边取自纸张，守 D15）。

                   尺寸按图标格的比例分档（17/42 ≈ 40.5%，与"图形 = 格子 × 50%"同一条规矩）：
                   32→13 / 42→17 / 56→23，字号同步 25%（8 / 10.5 / 14），圆角 = 半径。
                   写死 15 会在三档下变成 47%/36%/27% 漂移——正是"大中小下大小不一致"那个毛病。
                   描边恒定 1.5 不随档缩放（同手册：格子与图形缩放、描边不缩放）。

                   两个实现上的坑：
                   ① 尺寸必须写在 Style 的 Setter 里，不能写在元素上——本地值优先级高于
                      Style 的 Trigger，写在元素上触发器改不动。
                   ② 三档数值全取整数：窗口开了布局取整，2.5 这类小数会被舍掉。 -->
              <Border x:Name="badge" Visibility="{Binding HasCount, Converter={StaticResource BoolVis}}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,-2,0"
                      Padding="3,0,3,0"
                      Background="{DynamicResource Accent}"
                      BorderBrush="{DynamicResource Paper2}" BorderThickness="1.5"
                      SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Border.Style>
                  <Style TargetType="Border">
                    <!-- MinWidth（不是 Width）：两位数/三位数时角标自己拉宽成胶囊 -->
                    <Setter Property="MinWidth" Value="17"/>
                    <Setter Property="Height" Value="17"/>
                    <Setter Property="CornerRadius" Value="9"/>
                    <Setter Property="TextElement.FontSize" Value="10.5"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Value="32">
                        <Setter Property="MinWidth" Value="13"/>
                        <Setter Property="Height" Value="13"/>
                        <Setter Property="CornerRadius" Value="7"/>
                        <Setter Property="TextElement.FontSize" Value="8"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Value="56">
                        <Setter Property="MinWidth" Value="23"/>
                        <Setter Property="Height" Value="23"/>
                        <Setter Property="CornerRadius" Value="12"/>
                        <Setter Property="TextElement.FontSize" Value="14"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Count}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentOn}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="{Binding FontSize, RelativeSource={RelativeSource Self}}"/>
              </Border>
            </Grid>

            <TextBlock x:Name="label" Text="{Binding Label}" Margin="2,6,2,0"
                       FontSize="11" LineHeight="14" TextAlignment="Center"
                       Foreground="{DynamicResource Ink}" TextWrapping="Wrap"
                       MaxHeight="30" TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <!-- 失效标记（§4.6/§5）：Ink3 底 + Paper 文字的 15px 圆 +「!」，与收纳角标同位但互斥
               （组合磁贴 EntryId 为 null 不会失效，失效磁贴也不会有收纳数）。
               收纳角标已经移到图标格里（见上面 x:Name="badge"），这里只剩失效标记。 -->
          <Border x:Name="deadBadge" Visibility="Collapsed"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0"
                  Width="15" Height="15" CornerRadius="8"
                  Background="{DynamicResource Ink3}">
            <TextBlock Text="!" FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Paper}" HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Border>

      <DataTemplate.Triggers>
        <!-- 悬停（手册 §5）：整格 Paper2 底 + 框转 AccentLine + 图形转 Accent。
             放在**所有**触发器最前：类型触发器（组合/收尾/占位/真图标/文件夹）排在后面，
             会用各自的框色盖掉这里的 AccentLine——特殊格的身份色不被悬停冲掉。
             收尾格/占位格整体排除：它们是透明底的"非真磁贴"，整格刷 Paper2 会凭空多一块色。 -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsMouseOver, ElementName=root}" Value="True"/>
            <Condition Binding="{Binding IsMoreTile}" Value="False"/>
            <Condition Binding="{Binding IsGhostTile}" Value="False"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="root" Property="Background" Value="{DynamicResource Paper2}"/>
          <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
          <Setter TargetName="presetArt" Property="Stroke" Value="{DynamicResource Accent}"/>
        </MultiDataTrigger>

        <!-- 文件夹的类型图形排在 HasIcon **之后**，见文末那段注释 -->

        <DataTrigger Binding="{Binding IsGroupTile}" Value="True">
          <Setter TargetName="mini" Property="Visibility" Value="Visible"/>
          <Setter TargetName="box" Property="Background" Value="{DynamicResource Paper}"/>
          <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Ink3}"/>
        </DataTrigger>

        <DataTrigger Binding="{Binding IsMoreTile}" Value="True">
          <Setter TargetName="box" Property="Background" Value="Transparent"/>
          <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
          <Setter TargetName="ghost" Property="Visibility" Value="Visible"/>
          <Setter TargetName="presetArt" Property="Stroke" Value="{DynamicResource Accent}"/>
          <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Accent}"/>
          <Setter TargetName="label" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>

        <!-- 收尾格悬停（§4.7）：AccentSoft 底 + 实线 Accent 框。排在 IsMoreTile 之后才能
             把它那两条 Transparent 盖掉；整格底色仍不刷（它是"出口"，不是磁贴）。 -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsMouseOver, ElementName=root}" Value="True"/>
            <Condition Binding="{Binding IsMoreTile}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentSoft}"/>
          <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </MultiDataTrigger>

        <!-- 拖放占位格：一圈虚线 + 下箭头，不写文案（定稿要"最低打扰"）。
             root 整块不吃命中，所以它既点不动也弹不出右键菜单，落在这格上等于
             落在面板空白处——拖放照样收。 -->
        <DataTrigger Binding="{Binding IsGhostTile}" Value="True">
          <Setter TargetName="box" Property="Background" Value="Transparent"/>
          <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
          <Setter TargetName="ghost" Property="Visibility" Value="Visible"/>
          <Setter TargetName="presetArt" Property="Stroke" Value="{DynamicResource Accent}"/>
          <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="root" Property="IsHitTestVisible" Value="False"/>
        </DataTrigger>

        <!-- 真图标到了就显示贴片。**纸卡（box）不再让位** —— B 方案里贴片只占 80%，
             纸卡是它底下那层"画框"，藏起来反而和线稿磁贴不是同一种画法了。
             （原来把底和描边设成 Transparent，是为了避免"色块套图标"的双层感，
               那是满铺时代的说法；现在贴片自己带发丝描边，不会糊成一团。）
             放在 folder/group 触发器之后，靠顺序覆盖。 -->
        <DataTrigger Binding="{Binding HasIcon}" Value="True">
          <Setter TargetName="art" Property="Visibility" Value="Visible"/>
        </DataTrigger>

        <!-- 文件夹必须排在 HasIcon **之后**：文件类一律用预设图形、不抢真图标（UI 手册 §6 的替代范围）。
             排在前面会被 HasIcon 盖掉，文件夹又退回系统图标、观感又散回去了。
             所以这里连 art 一起压掉：文件夹永远显示 GlyphFolder。 -->
        <DataTrigger Binding="{Binding IsFolderTile}" Value="True">
          <Setter TargetName="art" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="presetArt" Property="Stroke" Value="{DynamicResource Accent}"/>
          <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentSoft}"/>
          <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
        </DataTrigger>

        <!-- 选中态 = S1（design/selection-proposals.html）：<b>只留整卡淡底</b>。
             原来还叠了 chip 实线主题框 + 线稿变色 + chip 内圈环，四层糊在一起；
             而且"淡底 + chip 主题框"这套组合是「拖放入组落点 / 新建组合 / 悬停收尾格」共用的，
             选中态不该再占一遍。现在 chip 描边、线稿颜色、内圈环<b>全部保持原样</b>，
             选中只由"这张卡被垫起来一层淡色"来表达。 -->
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="root" Property="Background" Value="{DynamicResource AccentSoft}"/>
        </DataTrigger>

        <!-- 拖拽排序：被拖的那块压暗。落点指示就是"磁贴自己在实时挪动"，
             不再额外画竖杠——前后移动本身就是最直观的指示。 -->
        <DataTrigger Binding="{Binding Dragging}" Value="True">
          <Setter TargetName="root" Property="Opacity" Value="0.4"/>
          <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
          <Setter TargetName="presetArt" Property="Stroke" Value="{DynamicResource Accent}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding DropHint}" Value="True">
          <Setter TargetName="root" Property="Background" Value="{DynamicResource AccentSoft}"/>
          <!-- 落点提示**只由这一圈环表达** —— 底下那两层通用描边在提示态一律让位：
                 · art  的 1px Rule 贴片边
                 · box  的 1px Rule chip 边 + Paper2 底
               不让位就是"边上有好几圈框"（2026-09-30 用户截图反馈）：
               贴片边 + chip 边 + 这圈环 + 放大后的间距，读起来像四个方框套着。
               合并态要说的只有"这两块要并在一起"，此时"磁贴边框"本身是干扰信息。 -->
          <Setter TargetName="art" Property="Stroke" Value="Transparent"/>
          <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
          <Setter TargetName="box" Property="Background" Value="Transparent"/>
          <Setter TargetName="dropRing" Property="Visibility" Value="Visible"/>
          <Setter TargetName="presetArt" Property="Stroke" Value="{DynamicResource Accent}"/>
        </DataTrigger>

        <!-- 「两个图标叠到一起」：目标磁贴"鼓"起来（放大 + 粗描边）。
             与上面的 DropHint 刻意区分——那是"并进已有组合"，这里是"新建一个组合"，
             两者的结果完全不同，所以视觉上也不能长得一样。 -->
        <DataTrigger Binding="{Binding MergeHint}" Value="True">
          <Setter TargetName="root" Property="Background" Value="{DynamicResource AccentSoft}"/>
          <Setter TargetName="root" Property="RenderTransformOrigin" Value="0.5,0.4"/>
          <Setter TargetName="root" Property="RenderTransform">
            <Setter.Value>
              <!-- 1.1 → 1.06：放大是为了"鼓起来"，但每放大一点，几层描边之间的间距就散开一点。
                   收到 1.06 仍然看得出鼓起，又不至于把线散成"好几个框"。 -->
              <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
            </Setter.Value>
          </Setter>
          <!-- 同 DropHint：贴片边与 chip 边在提示态一律让位，只留这一圈环。
               粗细 2.5（并入 1.5）—— 画在覆盖环上而不是 BorderThickness 上：
               后者一改尺寸就跳，而且会被布局取整吃掉小数（当初就是因此从 2.5 退到 3 的）。
               StrokeThickness 是渲染属性，2.5 就是 2.5。 -->
          <Setter TargetName="art" Property="Stroke" Value="Transparent"/>
          <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
          <Setter TargetName="box" Property="Background" Value="Transparent"/>
          <Setter TargetName="mergeRing" Property="Visibility" Value="Visible"/>
          <Setter TargetName="presetArt" Property="Stroke" Value="{DynamicResource Accent}"/>
        </DataTrigger>

        <DataTrigger Binding="{Binding IsDead}" Value="True">
          <Setter TargetName="root" Property="Opacity" Value="0.42"/>
          <Setter TargetName="label" Property="TextDecorations" Value="Strikethrough"/>
          <!-- 实线框让位给 deadRing 的虚线：Border 画不出虚线描边。底板保留（§5 失效行只改框与透明度） -->
          <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
          <Setter TargetName="deadRing" Property="Visibility" Value="Visible"/>
          <Setter TargetName="deadBadge" Property="Visibility" Value="Visible"/>
          <Setter TargetName="presetArt" Property="Stroke" Value="{DynamicResource Ink3}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="10"
                  CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Edge}"
          BorderThickness="1" CornerRadius="{StaticResource PanelRadius}" ClipToBounds="True">
    <!-- 可聚焦：主面板的键盘落点。呼出时把焦点交给它，而不是让它落到标题栏那三个按钮上
         （后者会连带弹出它们的提示，见 ResetChromeHoverState 的注释）。
         焦点框不会因此出现：App 级已把 FocusVisualStyleKey 覆盖成空模板。 -->
    <Grid x:Name="MainRoot" Focusable="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ============ 标题栏：整条是系统拖拽区，按钮逐个豁免 ============ -->
      <Grid Grid.Row="0" Margin="16,0,13,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TitleText" Grid.Column="0" Text="Paperwork" VerticalAlignment="Center"
                   FontFamily="{StaticResource BookFont}" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink}"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <!-- 备忘录入口：横版折角纸 + 两条文字线。
               注意 Path 不继承 Foreground，必须显式绑回去，否则 IconButton 的悬停变色对它无效。
               为什么是两条线而不是设计稿里的三条：24 单位装在 15px 里，三条的 3 单位间距
               只剩 1.9px，配 1.6px 笔宽会糊成一坨实心块（截图里那个"太重"的效果）。
               两条线间距 4.5 单位 ≈ 2.8px，笔宽收到 1.3，才读得出是"纸上有字"。 -->
          <Button x:Name="MemoButton" Style="{StaticResource IconButton}" Margin="0,0,2,0" ToolTip="备忘录"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Width="15" Height="15" Stretch="Uniform" StrokeLineJoin="Round" StrokeThickness="1.3"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M 5,3.5 H 19 V 14.5 L 14.5,19 H 5 Z  M 19,14.5 H 14.5 V 19  M 8,8.5 H 16  M 8,13 H 13"/>
          </Button>

          <!-- 齿轮改成了路径，不再是字体字形 —— 理由见 FontGlyphPath 的注释：
               图标字体只有 Normal / Bold 两档（Medium、SemiBold 实测都回落到这两档），
               而"比 Bold 细一点点"正好落在两档中间，字重表达不出来。
               取成路径后粗细由 StrokeThickness 连续控制：0 = 字形自带 Normal，
               0.30 = 字形自带 Bold 的笔画粗细，当前 0.25 就是"比 Bold 细一点点"。
               Data 在构造函数里现场从字体取，所以形状仍与系统图标一致。
               注意 Path 不继承 Foreground，必须显式绑回去，否则 IconButton 的悬停变色对它无效。 -->
          <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Margin="0,0,2,0" ToolTip="设置">
            <Path x:Name="SettingsGlyph" Width="15" Height="15" Stretch="Uniform"
                  StrokeLineJoin="Round" StrokeThickness="0.25"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="HideButton" Style="{StaticResource IconButton}" ToolTip="关闭">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- 面包屑：有层级时替换掉标题文字。按钮逐个在代码里豁免给 WindowChrome -->
      <ItemsControl x:Name="Crumb" Grid.Row="0" VerticalAlignment="Center" Margin="16,0,120,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Border Grid.Row="1" Margin="15,0,15,8" Height="30" x:Name="SearchRow"
              Background="{DynamicResource Paper2}" BorderBrush="{DynamicResource Rule}"
              BorderThickness="1" CornerRadius="9"
              WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid>
          <!-- 不再写「搜索本层」：现在是全局搜索（条目 / 组合 / 备忘），
               但**不含文件夹内部**——那句话放在空态里说，不是放在占位符里。 -->
          <TextBlock x:Name="SearchHint" Text="搜索…" Margin="9,0,0,0" VerticalAlignment="Center"
                     FontSize="11.5" Foreground="{DynamicResource Ink3}" IsHitTestVisible="False"/>
          <TextBox x:Name="SearchBox" Margin="6,0,6,0" Padding="4,0,0,0" VerticalContentAlignment="Center"
                   Background="Transparent" BorderThickness="0" FontSize="11.5"
                   Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Accent}"/>
        </Grid>
      </Border>

      <Border Grid.Row="2" Height="1" Margin="16,0,16,0" Background="{DynamicResource Rule}"/>

      <ScrollViewer x:Name="Scroller" Grid.Row="3" Margin="12,10,6,0"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Focusable="False" Padding="0,0,4,0">
        <!-- Control.VerticalContentAlignment 默认是 Center，不显式设 Top 会让不满一屏的磁贴整块居中 -->
        <ItemsControl x:Name="Tiles" Focusable="False"
                      VerticalAlignment="Top" VerticalContentAlignment="Top">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <shell:TilePanel IconSize="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>

      <Border x:Name="EmptyHint" Grid.Row="3" Margin="16,10,16,8" Visibility="Collapsed">
        <Grid>
          <!-- 外圈虚线：Rule → AccentLine。空态该说的是"这里可以放东西"，而 Rule 是纸张的
               "分隔线"色，读起来只是"这里空着" —— "单调"就是从这儿来的。
               AccentLine 与拖放占位格、磁贴边框是同一支笔；DynamicResource 跟着主题走（D15），
               换纸换色自动跟随，一行主题分支都不用写。 -->
          <Rectangle Stroke="{DynamicResource AccentLine}" StrokeThickness="1.5"
                     StrokeDashArray="5 4" RadiusX="14" RadiusY="14"/>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- 拖放占位那颗图标搬进来（design/empty-state-proposals.html 的 B 版）：
                 箭头住在自己的小虚线底座里，与外圈同色同心 —— 拖之前看到的，
                 就是拖的时候会出现的那一格，语义不必解释。
                 底座必须是 Rectangle：WPF 的 Border 画不出虚线（占位格那边踩过这个坑）。
                 虚线节奏照抄 GhostRing（1.67 1.67 = 2.5 段 / 2.5 空 @1.5 笔宽），
                 两处是同一种虚线；圆角 14 = 图标座圆角 11 按 42→56 放大后减半个笔宽，
                 和 GhostRing 同一条算法。
                 IsHitTestVisible=False：落在这上面等于落在面板空白处（与占位格同一个理由）。 -->
            <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,10"
                  IsHitTestVisible="False">
              <Rectangle Stroke="{DynamicResource AccentLine}" StrokeThickness="1.5"
                         StrokeDashArray="1.67 1.67" RadiusX="14" RadiusY="14"
                         SnapsToDevicePixels="True"/>
              <Path x:Name="EmptyIcon" Width="26" Height="26" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <TextBlock x:Name="EmptyTitle" Text="把任意文件拖进来" FontSize="12.5"
                       HorizontalAlignment="Center" Foreground="{DynamicResource Ink2}"/>
            <TextBlock x:Name="EmptySub" Text="程序、快捷方式、文件夹、文档、图片、压缩包…"
                       FontSize="10.5" Margin="0,6,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Ink3}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 页叠边缘：贴右下 R 角的两道 45° 斜线（V2 方案）。
           靠角那条 7.1px、外侧 15.6px、两者垂直间距 5.1px、整组 11.6×11.6；
           离角远近由 Margin 控制（当前离弧约 6px），调它不会改变两条线的间距。
           纯装饰——真正的拉伸由 WindowChrome.ResizeBorderThickness=10 负责。 -->
      <Path Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,8,8" Stroke="{DynamicResource GripLine}" StrokeThickness="1.4"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            IsHitTestVisible="False"
            Data="M 6.6,11.6 L 11.6,6.6  M 0,11 L 11,0"/>

      <TextBlock Grid.Row="4" x:Name="StatusText" Margin="16,6,86,10"
                 FontSize="10.5" Foreground="{DynamicResource Ink3}"/>

      <!-- ============================ 全局搜索 ============================
           只占内容区（第 4 行起、跨到状态行），**标题行与搜索框一律不动**：
           搜索框位置、左上角面包屑位置都与首页完全一致，输入时界面不跳。
           背景留 Transparent：右下角那两道伸缩斜线要透出来，那是面板自己的装饰。

           行卡片的规格直接抄备忘列表的 NoteCard（padding 12,9 / 圆角 10 / 标题 12.5 SemiBold /
           副信息 11 且行高 16.5），不另起一套——UI 手册里"列表就该长这样"只有一个答案。 -->
      <Border x:Name="SearchPanel" Grid.Row="3" Grid.RowSpan="2" Background="Transparent" Visibility="Collapsed">
        <Grid>
          <!-- 定位抄备忘页的 ScrollViewer：上 6 = 与发丝线的空档；右 12 = 避开拉伸热区；
               下 22 = 让开圆角，滚动条不画进 R 角。 -->
          <ListBox x:Name="SearchList" Margin="0,6,12,22" Padding="16,0,14,4"
                   Background="Transparent" BorderThickness="0" Focusable="False"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <!-- 不可聚焦：点了结果之后光标必须还留在搜索框里，否则接着打字就打不进去了。
                     ↑↓ / Enter 由搜索框自己的 PreviewKeyDown 处理。 -->
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="bd" Background="{DynamicResource Paper2}"
                              BorderBrush="{DynamicResource Rule}" BorderThickness="1"
                              CornerRadius="10" Padding="12,9,12,9">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                          <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                          <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- 类型标识：条目走预设线稿，备忘走备忘形 + 强调色淡底，
                       组合走首页同款 2×2 迷你格（它是"容器"，和文件夹不是一回事）。
                       必须 VerticalAlignment=Center：卡片里文字有两行，图形格子比文字矮，
                       靠上的话就是"图标顶在上面、下面空一截"——视觉上整个列表左重右轻。 -->
                  <Border x:Name="glyphBox" Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                          Background="{DynamicResource Paper2}" BorderBrush="{DynamicResource Rule}"
                          BorderThickness="1" VerticalAlignment="Center">
                    <Grid>
                      <!-- 程序/自定义图标走真图标（IconPump 异步填），线稿只在没拿到时兜底 -->
                      <Image x:Name="art" Width="18" Height="18" Stretch="Uniform"
                             Source="{Binding Icon}" Visibility="{Binding IconVisibility}"
                             RenderOptions.BitmapScalingMode="HighQuality"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Path x:Name="glyph" Width="16" Height="16" Stretch="Uniform"
                            Data="{Binding Glyph}" Stroke="{DynamicResource Ink2}"
                            StrokeThickness="1.6" StrokeLineJoin="Round"
                            Visibility="{Binding GlyphVisibility}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <UniformGrid x:Name="mini" Rows="2" Columns="2" Width="16" Height="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed">
                        <Border CornerRadius="3" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"/>
                        <Border CornerRadius="3" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Rule}" BorderThickness="1"/>
                        <Border CornerRadius="3" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Rule}" BorderThickness="1"/>
                        <Border CornerRadius="3" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"/>
                      </UniformGrid>
                    </Grid>
                  </Border>

                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                               TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Name.Prefix}"/><Run Text="{Binding Name.Match}"
                           Foreground="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}"
                           FontWeight="Bold"/><Run Text="{Binding Name.Suffix}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" LineHeight="16.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Sub.Prefix}"/><Run Text="{Binding Sub.Match}"
                           Foreground="{DynamicResource Accent}"/><Run Text="{Binding Sub.Suffix}"/>
                    </TextBlock>
                  </StackPanel>

                  <!-- 备忘右端钉标签：没标题的备忘名字位显示的是正文首行，
                       没有这个标签就认不出它是备忘。 -->
                  <TextBlock Grid.Column="2" Text="备忘" FontSize="10" Margin="10,0,0,0"
                             VerticalAlignment="Top" Foreground="{DynamicResource Ink3}"
                             Visibility="{Binding IsNote, Converter={StaticResource BoolVis}}"/>
                </Grid>

                <!-- 用 x:Static 而不是写 Value="Group"：DataTrigger.Value 是 object，
                     写字符串就是字符串，不会自动变成枚举——那样永远匹配不上，静默失效。 -->
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="{x:Static data:SearchHitKind.Group}">
                    <Setter TargetName="glyph" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="mini" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="{x:Static data:SearchHitKind.Note}">
                    <Setter TargetName="glyphBox" Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter TargetName="glyphBox" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
                    <Setter TargetName="glyph" Property="Stroke" Value="{DynamicResource Accent}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 空态：不是空白就完事——得说清楚搜的是什么、不含什么，
               否则用户会以为"文件夹里的东西怎么搜不到"是 bug。 -->
          <Border x:Name="SearchEmpty" Margin="16,10,16,8" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="未找到，搜索不含文件夹" FontSize="12.5"
                         HorizontalAlignment="Center" Foreground="{DynamicResource Ink2}"/>
              <TextBlock Text="能搜到的是：条目 · 组合 · 备忘标题与正文" FontSize="10.5"
                         Margin="0,6,0,0" HorizontalAlignment="Center"
                         Foreground="{DynamicResource Ink3}"/>
            </StackPanel>
          </Border>

          <!-- 状态行：叠在列表底边之上，右 86 与主面板一样留给右下斜线 -->
          <TextBlock x:Name="SearchStatus" VerticalAlignment="Bottom" Margin="16,0,86,10"
                     FontSize="10.5" Foreground="{DynamicResource Ink3}"/>
        </Grid>
      </Border>

      <!-- ============================ 备忘录 · 列表 ============================
           与设置页同款：覆盖层，不进 NavStack、不写 state.json 的 Nav。
           所以 D17「两层封顶」完全不用动，重启后也不会停在备忘页。 -->
      <Border x:Name="MemoPanel" Grid.Row="0" Grid.RowSpan="5" Background="{DynamicResource Paper}"
              CornerRadius="{StaticResource PanelRadius}" Visibility="Collapsed">
        <Grid>
          <!-- 只有三行：状态栏不做成独立行，而是叠在列表那一行的底部。
               做成独立行的话，ScrollViewer 的 margin-bottom 22 会从**那一行顶部**量起，
               实际比 R 角多让出一个状态栏的高度 —— 滚动条就顶不到弧的起点上了。 -->
          <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- 面包屑 Paperwork / Memo：与钻进组合/文件夹同一套（§2），不新造 -->
          <Grid Grid.Row="0" Margin="16,0,13,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="MemoCrumbHome" Style="{StaticResource CrumbButton}" Content="Paperwork"
                      WindowChrome.IsHitTestVisibleInChrome="True"/>
              <TextBlock Text="/" FontSize="11" Margin="7,0,7,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Ink3}"/>
              <TextBlock Text="Memo" FontFamily="{StaticResource BookFont}" FontSize="15"
                         FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
            </StackPanel>
            <Button x:Name="MemoClose" Style="{StaticResource IconButton}" ToolTip="关闭"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True">
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
            </Button>
          </Grid>

          <Border Grid.Row="1" Height="1" Margin="16,0,16,0" Background="{DynamicResource Rule}"/>

          <!-- 定位照抄设置页的 ScrollViewer：
                 上 6 = 与发丝线的空档；右 12 = 避开 ResizeBorderThickness=10 的拉伸热区；
                 下 22 = 圆角半径，滑块底端与弧的起点齐平，不画进 R 角。
               padding：右 14 → 卡片右缘离滚动条约 7px；下 4 → 最后一张卡离面板底 26，
               刚好让开状态栏文字（占 bottom 10–24），不多留空白。
               注意：这套非对称的内缩**只作用于卡片**。空态（MemoEmpty）已经挪到 ScrollViewer
               外面自己给 Margin —— 它原来跟着一起偏，左右差 10px。 -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" Focusable="False"
                        Margin="0,6,12,22" Padding="16,0,14,4">
            <StackPanel>
              <ItemsControl x:Name="MemoList" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource NoteCard}" Tag="{Binding Id}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 有条目时的新建入口：跟在最后一条下面，**52px 与单行条目等高、Margin 6 与条目同距**。
                   虚线规格照抄空态 MemoEmpty（Rectangle 1.5 / DashArray "5 4" / 半径 = 圆角 10 − 0.75 = 9.25）；
                   悬停分两处管：Rectangle 的 Stroke 用 DataTrigger 切 AccentLine → Accent，
                   文字同理，底色归 NoteGhostRow 模板的 IsMouseOver 触发器。
                   点击 = CreateNote()，与右下角 FAB、空态提示区是同一个入口。
                   **可见性在 RenderMemoList 里与空态互斥**（有条目才出现，空态时它藏起来）。
                   命中测试不用操心：InsideInteractive 认 Button，所以点它不会被当成"点空白返回"。 -->
              <Button x:Name="MemoNewRow" Style="{StaticResource NoteGhostRow}"
                      HorizontalAlignment="Stretch" Height="52" Margin="0,0,0,6" ToolTip="新建备忘">
                <Grid>
                  <Rectangle StrokeThickness="1.5" StrokeDashArray="5 4" RadiusX="9.25" RadiusY="9.25"
                             Stretch="Fill" IsHitTestVisible="False">
                    <Rectangle.Style>
                      <Style TargetType="Rectangle">
                        <Setter Property="Stroke" Value="{DynamicResource AccentLine}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Rectangle.Style>
                  </Rectangle>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- + 的形状与右下角 FAB 同一条 Data（24 格），只换尺寸与笔宽 -->
                    <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0"
                          Stroke="{DynamicResource Accent}" Data="M 12,5 V 19  M 5,12 H 19"/>
                    <TextBlock Text="新建备忘" FontSize="12" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </Button>
            </StackPanel>
          </ScrollViewer>

          <!-- 空态：整块可点（与右下角 FAB 等价的入口）。
               **不放在 ScrollViewer 里** —— 2026-09-30 改的：
               ScrollViewer 的 Margin(0,6,12,22) + Padding(16,0,14,4) 让里面的东西
               左 16 / 右 26，空态跟着一起偏，肉眼一眼看出"左右不对等"。
               空态本来不需要滚动，挪出来自己给 Margin，对称就是结构上成立的，
               不用靠负 margin 去凑；左右 16 与主面板空态 EmptyHint 同一条基准线。
               外框是虚线，**贴在外框边缘、顶替原来的实线**（不是"实线套虚线"）：
               虚线规格照抄主面板空态 EmptyHint（5 4 @1.5 笔宽 = 7.5px 段 / 6px 空），
               所以同一个应用里"整块可点的空态框"只有一种画法。
               必须用 Rectangle：WPF 的 Border 画不出虚线（收尾格、EmptyHint 都踩过）。
               RadiusX 13.25 = 外边圆角 14 − 半个笔宽（Rectangle 的圆角量的是描边中心线，
               Border 的 CornerRadius 量的是外缘）。
               **Rectangle 绝不能写 Width/Height**（三轮改法才定下来）：
                 ① 只写 Stretch="Fill" 且让它参与测量 → 期望尺寸退回 0，虚线缩成
                    "包住图标和文字的小方框"（实测 128×188）；
                 ② 改成 Width/Height 绑外层 Border → 循环依赖，整块塌成"从列表顶画到
                    面板底"的一整条（实测 611×409）；
                 ③ 显式给了 Width/Height 之后**虚线静默变实线**（同一份 StrokeDashArray
                    在 EmptyHint 上仍是虚线，区别只有"有没有显式尺寸"）。
               所以尺寸由模板里那个双向拉伸的 ContentPresenter 交给它，Rectangle 只负责铺满。
               悬停变色也归 Rectangle：它的样式用 DataTrigger 绑祖先 Button.IsMouseOver，
               Stroke 在 AccentLine ⇄ Accent 之间切（底色仍由 NoteEmpty 的模板触发器管）。 -->
          <Button x:Name="MemoEmpty" Grid.Row="2" Style="{StaticResource NoteEmpty}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,6,16,0">
            <Grid>
              <Rectangle StrokeThickness="1.5"
                         StrokeDashArray="5 4" RadiusX="13.25" RadiusY="13.25"
                         Stretch="Fill" IsHitTestVisible="False">
                <Rectangle.Style>
                  <Style TargetType="Rectangle">
                    <Setter Property="Stroke" Value="{DynamicResource AccentLine}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Rectangle.Style>
              </Rectangle>
              <!-- 内容留白归这里管（NoteEmpty 自己不带 Padding：虚线要贴外框边缘，
                   Padding 会把虚线一起推进来）。
                   上下 28/26、图标↔标题 12、两行间 6 —— 2026-09-30 的空态改版
                   （原来 24/24、10、5：框显得小，上下也不匀）。 -->
              <Border Padding="16,28,16,26">
                <StackPanel>
                  <Border Width="42" Height="42" CornerRadius="11" Margin="0,0,0,12"
                          HorizontalAlignment="Center" Background="{DynamicResource Paper2}"
                          BorderBrush="{DynamicResource Rule}" BorderThickness="1">
                    <!-- 与标题栏入口同一个形状（两条文字线），换尺寸不换笔法 -->
                    <Path Width="21" Height="21" Stretch="Uniform" StrokeLineJoin="Round" StrokeThickness="1.6"
                          Stroke="{DynamicResource Ink3}"
                          Data="M 5,3.5 H 19 V 14.5 L 14.5,19 H 5 Z  M 19,14.5 H 14.5 V 19  M 8,8.5 H 16  M 8,13 H 13"/>
                  </Border>
                  <TextBlock Text="还没有备忘" FontSize="12.5" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                  <TextBlock Text="点这里，或右下角的 ＋，写一条" FontSize="11" Margin="0,6,0,0"
                             HorizontalAlignment="Center" Foreground="{DynamicResource Ink3}"/>
                </StackPanel>
              </Border>
            </Grid>
          </Button>

          <!-- 状态栏：叠在列表底边之上（覆盖层盖住了主面板的 StatusText，所以这里自己来一份）。
               右 86 与主面板一样留给右下斜线。 -->
          <TextBlock x:Name="MemoStatus" Grid.Row="2" VerticalAlignment="Bottom"
                     Margin="16,0,86,10" FontSize="10.5" Foreground="{DynamicResource Ink3}"/>

          <!-- FAB：贴面板底边定位（bottom 40 避开右下斜线的 8–20） -->
          <Button x:Name="MemoAdd" Grid.Row="2" Style="{StaticResource NoteFab}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,40"
                  ToolTip="新建备忘" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>
      </Border>

      <!-- ============================ 备忘录 · 编辑 ============================ -->
      <Border x:Name="MemoEditPanel" Grid.Row="0" Grid.RowSpan="5" Background="{DynamicResource Paper}"
              CornerRadius="{StaticResource PanelRadius}" Visibility="Collapsed">
        <Grid>
          <!-- 三行：状态栏不做成独立行，叠在表单那一行的底部。
               做成独立行的话「置顶 / 删除」就永远够不到底边——它们会停在状态栏那一行的上沿，
               下面白白空出一整条（就是"内容框太短、下面留太多"的成因）。 -->
          <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="16,0,13,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="MemoEditCrumbHome" Style="{StaticResource CrumbButton}" Content="Paperwork"
                      WindowChrome.IsHitTestVisibleInChrome="True"/>
              <TextBlock Text="/" FontSize="11" Margin="7,0,7,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Ink3}"/>
              <TextBlock Text="Memo" FontFamily="{StaticResource BookFont}" FontSize="15"
                         FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
            </StackPanel>
            <Button x:Name="MemoEditClose" Style="{StaticResource IconButton}" ToolTip="保存并返回"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True">
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
            </Button>
          </Grid>

          <Border Grid.Row="1" Height="1" Margin="16,0,16,0" Background="{DynamicResource Rule}"/>

          <!-- 底部留 10：与左下角状态栏文字的底边对齐（两者都距面板底 10）。
               原先留 32 是为了避开右下斜线装饰，但斜线在主面板的 Row 4，而本覆盖层
               RowSpan=5 把它整个盖住了 —— 编辑页里根本看不到那两条线，这个避让是白留的，
               代价是内容框白白矮了 52px。
               表单区整体命名 MemoForm：点空白返回时，落在它里面的点击不算空白，
               否则瞄准输入框时点到旁边的标签就会把整页关掉。

               Background="Transparent" 是这条守卫的**必要条件**，不是装饰：
               WPF 里 Background 为 null 的 Grid 不可命中，点它的空白处事件会直接穿透到
               后面的 MemoEditPanel 上；而那时从 MemoEditPanel 往上走永远碰不到 MemoForm，
               CloseEditor 的判断就只能看到"空白"，守卫形同虚设。
               结果就是：瞄准 18px 的置顶小方格、点歪一点，整页直接关掉。 -->
          <Grid x:Name="MemoForm" Grid.Row="2" Margin="16,2,16,10" Background="Transparent">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="标题" FontSize="10.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Ink3}" Margin="2,0,0,5"/>
            <!-- 不要设 MaxHeight：模板里 Padding 上下各 8 + 边框 2 已经占掉 18px，
                 13px 的字一行要 ~18px，夹到 34 就只剩 16px 给文字 —— 字被裁掉，
                 表现为"标题栏写不进任何东西"。 -->
            <TextBox x:Name="MemoTitle" Grid.Row="1" Style="{StaticResource NoteField}"
                     FontSize="13" FontWeight="SemiBold" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="内容" FontSize="10.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Ink3}" Margin="2,9,0,5"/>
            <TextBox x:Name="MemoBody" Grid.Row="3" Style="{StaticResource NoteField}"
                     FontSize="12.5" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     MinHeight="120"/>

            <!-- 置顶与删除并排靠右：状态栏文字在左，右下是斜线装饰，所以这一行只能待在右侧 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,9,0,0">
              <!-- 两个都不设 VerticalAlignment：默认 Stretch，一起撑满这一行的高度。
                   置顶那一行的热区现在是 30px（9,6 内边距 + 上下各 1px 边框），
                   比删除按钮期望的 28 高，给删除按钮设 Center 的话它的底边就会比置顶高 1px、
                   也比状态栏高 1px。都撑满，两者的底边才和左下角状态栏文字在同一条线上。 -->
              <CheckBox x:Name="MemoPin" Style="{StaticResource NoteCheck}" Content="置顶"
                        Margin="0,0,10,0"/>
              <Button x:Name="MemoDelete" Style="{StaticResource NoteDangerButton}" ToolTip="删除这条备忘">
                <StackPanel Orientation="Horizontal">
                  <Path Width="13" Height="13" Stretch="Uniform" StrokeLineJoin="Round" StrokeThickness="1.6"
                        Margin="0,0,6,0"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Data="M 4.5,6.5 H 19.5  M 9.5,6.5 V 4.8 H 14.5 V 6.5  M 6.5,6.5 L 7.5,19.5 H 16.5 L 17.5,6.5"/>
                  <TextBlock Text="删除这条备忘" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- 叠在表单行底部，右 86 与主面板状态栏一样避开右下角那一带。

               **必须 IsHitTestVisible=False**：它声明在 MemoForm 之后 → z 序在上，
               而底边距与 MemoForm 一样是 10（两者底边在同一条线上），于是它那条
               **13.3px 高的矩形正好罩住「置顶 / 删除」的下半截** —— 实测置顶 30px 高、
               底部 13.3px 全部重叠（探针数据见 README）。TextBlock 的命中测试是**整个矩形**
               （不是只有文字那一小块），所以点在按钮下半截，命中的是这个状态栏：
               它既不是 Button/TextBox/CheckBox，父级又是外层 Grid 而不是 MemoForm →
               「点空白返回」那两条判断都不满足 → **编辑页被关掉**（2026-10-01 修）。

               它只是一行读数，本来就不该吃点击。关掉之后，点它那片会穿透到 MemoForm，
               反而回到"不算空白"的正确行为上。 -->
          <TextBlock x:Name="MemoEditStatus" Grid.Row="2" VerticalAlignment="Bottom"
                     IsHitTestVisible="False"
                     Margin="16,0,86,10" FontSize="10.5" Foreground="{DynamicResource Ink3}"/>
        </Grid>
      </Border>

      <!-- ============================ 设置页 ============================ -->
      <Border x:Name="SettingsPanel" Grid.Row="0" Grid.RowSpan="5" Background="{DynamicResource Paper}"
              CornerRadius="{StaticResource PanelRadius}" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="16,0,13,0">
            <!-- 标题占首页「Paperwork」那个位置，同一套字形；退出改由右上角 ✕ 和 Esc 负责 -->
            <TextBlock Text="Settings" FontFamily="{StaticResource BookFont}" FontSize="15"
                       FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Ink}"/>
            <Button x:Name="SettingsClose" Style="{StaticResource IconButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True">
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
            </Button>
          </Grid>

          <Border Grid.Row="1" Height="1" Margin="16,0,16,0" Background="{DynamicResource Rule}"/>

          <!-- Margin 四个值全是给滚动条定位的，不是装饰：
               上 13 = 滑块与上方分隔线之间的空档，顶到线就是连成一坨；
               右 12 = 避开 WindowChrome.ResizeBorderThickness=10 的拉伸热区，贴边点下去有一半在拉窗口；
               下 22 = 正好落在右缘直线开始变弯的地方（圆角半径），滑块底端与弧的起点齐平——
               再往外就会穿过 22px 圆角弧画到面板外（ClipToBounds 是矩形裁剪，管不了圆角）。
               Padding 上给 0：顶部空档由 margin 出，内容起始位置和原来差不多。 -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Focusable="False" Margin="0,13,12,22" Padding="16,0,8,8">
            <!-- 可聚焦：这是设置页的键盘落点。
                 M4-P4 为了压掉焦点虚框，把上面的 ScrollViewer 设成 Focusable="False"、
                 打开时又 Keyboard.ClearFocus()，两层叠加的结果是焦点无处可落——
                 WPF 没有键盘事件的目标，改键永远卡在"按下新组合键…"、Esc 关设置页也失效。
                 所以这里必须留一个可聚焦的落点，由 OpenSettings 主动把焦点交过来。
                 焦点框不会因此复现：App 级已把 FocusVisualStyleKey 覆盖成空模板。 -->
            <StackPanel x:Name="SettingsRoot" Focusable="True" FocusVisualStyle="{x:Null}">
              <!-- 密度原则（UI 手册 S7）：每行只讲一件事，能合并成一行的绝不拆三行。
                   主题色/纸张各压成一行三片、图标三档并成一行分段控件、锚点两行并成一行开关，
                   快捷键并入「呼出与停靠」-> 13 行 6 组收成 8 行 5 组，一屏放得下不用滚。 -->

              <TextBlock Text="主题色" FontSize="10.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource Ink3}" Margin="0,0,0,8"/>
              <UniformGrid Columns="3" Margin="0,0,0,14">
                <Border Style="{StaticResource OptionChip}" Tag="accent:forest">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="50" Height="32" CornerRadius="9" Background="{DynamicResource Paper2}"
                            BorderBrush="{DynamicResource Rule}" BorderThickness="1" Margin="0,0,9,0">
                      <Border Height="9" VerticalAlignment="Bottom" Background="#2F6B4F"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="森林绿" FontSize="11.5"/>
                      <TextBlock Text="#2F6B4F" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                 Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Tag="tick" Width="15" Height="15" CornerRadius="8" Margin="6,0,0,0"
                            Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                            VerticalAlignment="Center" Visibility="Collapsed">
                      <!-- 必须给 Stretch=Uniform + 显式尺寸：这段勾的几何从 (3.6,4.6) 起步，
                           不归一的话 Path 会按自己的坐标画，在 15px 圆球里被挤到右下角、
                           半截压在描边上 —— 看起来就是一颗实心圆球（列表页 NoteCheck 的勾
                           一直正常，正是因为它写了 Stretch + 尺寸）。
                           15px 球 - 1.5px 描边 = 12px 内容区，9px 的勾四周各留 1.5px。 -->
                      <Path Data="M3.6,7.4 L6.2,10 L10.6,4.6" Stretch="Uniform" Width="9" Height="9"
                            Stroke="{DynamicResource AccentOn}" StrokeThickness="1.8"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                  </Grid>
                </Border>
                <Border Style="{StaticResource OptionChip}" Tag="accent:sky">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="50" Height="32" CornerRadius="9" Background="{DynamicResource Paper2}"
                            BorderBrush="{DynamicResource Rule}" BorderThickness="1" Margin="0,0,9,0">
                      <Border Height="9" VerticalAlignment="Bottom" Background="#2E7BB5"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="天空蓝" FontSize="11.5"/>
                      <TextBlock Text="#2E7BB5" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                 Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Tag="tick" Width="15" Height="15" CornerRadius="8" Margin="6,0,0,0"
                            Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                            VerticalAlignment="Center" Visibility="Collapsed">
                      <!-- 必须给 Stretch=Uniform + 显式尺寸：这段勾的几何从 (3.6,4.6) 起步，
                           不归一的话 Path 会按自己的坐标画，在 15px 圆球里被挤到右下角、
                           半截压在描边上 —— 看起来就是一颗实心圆球（列表页 NoteCheck 的勾
                           一直正常，正是因为它写了 Stretch + 尺寸）。
                           15px 球 - 1.5px 描边 = 12px 内容区，9px 的勾四周各留 1.5px。 -->
                      <Path Data="M3.6,7.4 L6.2,10 L10.6,4.6" Stretch="Uniform" Width="9" Height="9"
                            Stroke="{DynamicResource AccentOn}" StrokeThickness="1.8"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                  </Grid>
                </Border>
                <Border Style="{StaticResource OptionChip}" Tag="accent:sunset">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="50" Height="32" CornerRadius="9" Background="{DynamicResource Paper2}"
                            BorderBrush="{DynamicResource Rule}" BorderThickness="1" Margin="0,0,9,0">
                      <Border Height="9" VerticalAlignment="Bottom" Background="#D2762E"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="夕阳橙" FontSize="11.5"/>
                      <TextBlock Text="#D2762E" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                 Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Tag="tick" Width="15" Height="15" CornerRadius="8" Margin="6,0,0,0"
                            Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                            VerticalAlignment="Center" Visibility="Collapsed">
                      <!-- 必须给 Stretch=Uniform + 显式尺寸：这段勾的几何从 (3.6,4.6) 起步，
                           不归一的话 Path 会按自己的坐标画，在 15px 圆球里被挤到右下角、
                           半截压在描边上 —— 看起来就是一颗实心圆球（列表页 NoteCheck 的勾
                           一直正常，正是因为它写了 Stretch + 尺寸）。
                           15px 球 - 1.5px 描边 = 12px 内容区，9px 的勾四周各留 1.5px。 -->
                      <Path Data="M3.6,7.4 L6.2,10 L10.6,4.6" Stretch="Uniform" Width="9" Height="9"
                            Stroke="{DynamicResource AccentOn}" StrokeThickness="1.8"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                  </Grid>
                </Border>
              </UniformGrid>

              <TextBlock Text="纸张" FontSize="10.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource Ink3}" Margin="0,0,0,8"/>
              <UniformGrid Columns="3" Margin="0,0,0,14">
                <Border Style="{StaticResource OptionChip}" Tag="paper:ivory">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="50" Height="32" CornerRadius="9" Background="#F4EFE3"
                            BorderBrush="{DynamicResource Rule}" BorderThickness="1" Margin="0,0,9,0">
                      <Border Height="9" VerticalAlignment="Bottom" Background="#DCCFB4"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="象牙纸" FontSize="11.5"/>
                      <TextBlock Text="#F4EFE3" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                 Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Tag="tick" Width="15" Height="15" CornerRadius="8" Margin="6,0,0,0"
                            Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                            VerticalAlignment="Center" Visibility="Collapsed">
                      <!-- 必须给 Stretch=Uniform + 显式尺寸：这段勾的几何从 (3.6,4.6) 起步，
                           不归一的话 Path 会按自己的坐标画，在 15px 圆球里被挤到右下角、
                           半截压在描边上 —— 看起来就是一颗实心圆球（列表页 NoteCheck 的勾
                           一直正常，正是因为它写了 Stretch + 尺寸）。
                           15px 球 - 1.5px 描边 = 12px 内容区，9px 的勾四周各留 1.5px。 -->
                      <Path Data="M3.6,7.4 L6.2,10 L10.6,4.6" Stretch="Uniform" Width="9" Height="9"
                            Stroke="{DynamicResource AccentOn}" StrokeThickness="1.8"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                  </Grid>
                </Border>
                <Border Style="{StaticResource OptionChip}" Tag="paper:kraft">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="50" Height="32" CornerRadius="9" Background="#E8DCC2"
                            BorderBrush="{DynamicResource Rule}" BorderThickness="1" Margin="0,0,9,0">
                      <Border Height="9" VerticalAlignment="Bottom" Background="#C9B48A"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="牛皮纸" FontSize="11.5"/>
                      <TextBlock Text="#E8DCC2" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                 Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Tag="tick" Width="15" Height="15" CornerRadius="8" Margin="6,0,0,0"
                            Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                            VerticalAlignment="Center" Visibility="Collapsed">
                      <!-- 必须给 Stretch=Uniform + 显式尺寸：这段勾的几何从 (3.6,4.6) 起步，
                           不归一的话 Path 会按自己的坐标画，在 15px 圆球里被挤到右下角、
                           半截压在描边上 —— 看起来就是一颗实心圆球（列表页 NoteCheck 的勾
                           一直正常，正是因为它写了 Stretch + 尺寸）。
                           15px 球 - 1.5px 描边 = 12px 内容区，9px 的勾四周各留 1.5px。 -->
                      <Path Data="M3.6,7.4 L6.2,10 L10.6,4.6" Stretch="Uniform" Width="9" Height="9"
                            Stroke="{DynamicResource AccentOn}" StrokeThickness="1.8"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                  </Grid>
                </Border>
                <Border Style="{StaticResource OptionChip}" Tag="paper:night">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="50" Height="32" CornerRadius="9" Background="#23211D"
                            BorderBrush="{DynamicResource Rule}" BorderThickness="1" Margin="0,0,9,0">
                      <Border Height="9" VerticalAlignment="Bottom" Background="#3A362F"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="夜空纸" FontSize="11.5"/>
                      <TextBlock Text="#23211D" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                 Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Tag="tick" Width="15" Height="15" CornerRadius="8" Margin="6,0,0,0"
                            Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                            VerticalAlignment="Center" Visibility="Collapsed">
                      <!-- 必须给 Stretch=Uniform + 显式尺寸：这段勾的几何从 (3.6,4.6) 起步，
                           不归一的话 Path 会按自己的坐标画，在 15px 圆球里被挤到右下角、
                           半截压在描边上 —— 看起来就是一颗实心圆球（列表页 NoteCheck 的勾
                           一直正常，正是因为它写了 Stretch + 尺寸）。
                           15px 球 - 1.5px 描边 = 12px 内容区，9px 的勾四周各留 1.5px。 -->
                      <Path Data="M3.6,7.4 L6.2,10 L10.6,4.6" Stretch="Uniform" Width="9" Height="9"
                            Stroke="{DynamicResource AccentOn}" StrokeThickness="1.8"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                  </Grid>
                </Border>
              </UniformGrid>

              <TextBlock Text="呼出与停靠" FontSize="10.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource Ink3}" Margin="0,0,0,7"/>
              <Border Style="{StaticResource OptionRow}" Tag="hotkey:">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="呼出快捷键" FontSize="12.5" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" CornerRadius="5" BorderBrush="{DynamicResource Rule}" BorderThickness="1"
                          Padding="7,2,7,2" Background="{DynamicResource Paper2}">
                    <TextBlock x:Name="HotkeyText" Text="Ctrl+Alt+D" FontSize="11" Foreground="{DynamicResource Ink2}"/>
                  </Border>
                </Grid>
              </Border>

              <!-- 锚点从「点谁选谁」两行改成一行开关：开 = 跟鼠标，关 = 记住上次位置 -->
              <Border Style="{StaticResource OptionRow}" Tag="anchor:toggle">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="出现在鼠标所在屏幕" FontSize="12.5"/>
                    <TextBlock Text="关闭则记住上次位置" FontSize="11" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" x:Name="togAnchor" Width="36" Height="20" CornerRadius="10"
                          Background="{DynamicResource Rule}">
                    <Ellipse x:Name="knobAnchor" Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0"
                             Fill="{DynamicResource Paper}"/>
                  </Border>
                </Grid>
              </Border>

              <TextBlock Text="尺寸" FontSize="10.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource Ink3}" Margin="0,14,0,7"/>
              <Border Style="{StaticResource OptionRow}" Margin="0,0,0,3">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <!-- 这一行是分段控件的容器，自己不带 Tag，所以永远轮不到 RefreshSettingVisuals
                         的 SetInk 来上色 —— 不显式给色的话，Foreground 一路继承到窗口顶层，
                         落到系统默认的纯黑。白天纸上看不出来，夜空黑底下就是一团看不清的黑字
                         （其它选项行都靠 Tag 拿到 Ink，唯独它漏了）。 -->
                    <TextBlock Text="图标大小" FontSize="12.5" Foreground="{DynamicResource Ink}"/>
                    <TextBlock Text="拉伸只重排列数，不改变图标尺寸" FontSize="11" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" Padding="3" CornerRadius="9" Background="{DynamicResource Paper2}"
                          BorderBrush="{DynamicResource Rule}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                      <Border Style="{StaticResource SegButton}" Tag="icon:32">
                        <StackPanel><TextBlock Text="小" FontSize="11" HorizontalAlignment="Center"/>
                          <TextBlock Text="32" FontSize="9.5" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center"/></StackPanel>
                      </Border>
                      <Border Style="{StaticResource SegButton}" Tag="icon:42">
                        <StackPanel><TextBlock Text="中" FontSize="11" HorizontalAlignment="Center"/>
                          <TextBlock Text="42" FontSize="9.5" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center"/></StackPanel>
                      </Border>
                      <Border Style="{StaticResource SegButton}" Tag="icon:56">
                        <StackPanel><TextBlock Text="大" FontSize="11" HorizontalAlignment="Center"/>
                          <TextBlock Text="56" FontSize="9.5" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center"/></StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <TextBlock Text="行为" FontSize="10.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource Ink3}" Margin="0,14,0,7"/>
              <Border Style="{StaticResource OptionRow}" Tag="flag:autorun">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="跟随系统启动" FontSize="12.5"/>
                  </StackPanel>
                  <Border Grid.Column="1" x:Name="togAutorun" Width="36" Height="20" CornerRadius="10"
                          Background="{DynamicResource Rule}">
                    <Ellipse x:Name="knobAutorun" Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0"
                             Fill="{DynamicResource Paper}"/>
                  </Border>
                </Grid>
              </Border>

              <Border Style="{StaticResource OptionRow}" Tag="flag:trayonclose">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="点 X 收进托盘而非退出" FontSize="12.5"/>
                    <TextBlock Text="避免误触把整个面板关掉" FontSize="11" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" x:Name="togTrayOnClose" Width="36" Height="20" CornerRadius="10"
                          Background="{DynamicResource Rule}">
                    <Ellipse x:Name="knobTrayOnClose" Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0"
                             Fill="{DynamicResource Paper}"/>
                  </Border>
                </Grid>
              </Border>

              <Border Style="{StaticResource OptionRow}" Tag="flag:groupbadge">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="显示组合收纳角标" FontSize="12.5"/>
                    <TextBlock Text="组合磁贴右上角的成员数" FontSize="11" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" x:Name="togGroupBadge" Width="36" Height="20" CornerRadius="10"
                          Background="{DynamicResource Rule}">
                    <Ellipse x:Name="knobGroupBadge" Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0"
                             Fill="{DynamicResource Paper}"/>
                  </Border>
                </Grid>
              </Border>

              <Border Style="{StaticResource OptionRow}" Tag="flag:hideonfullscreen">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="全屏应用时自动收起" FontSize="12.5"/>
                    <TextBlock Text="游戏、视频等全屏时面板主动让位" FontSize="11" Foreground="{DynamicResource Ink3}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" x:Name="togFullscreen" Width="36" Height="20" CornerRadius="10"
                          Background="{DynamicResource Rule}">
                    <Ellipse x:Name="knobFullscreen" Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0"
                             Fill="{DynamicResource Paper}"/>
                  </Border>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- 状态栏：设置页 RowSpan=5 把主面板的 StatusText 也盖住了，而改键成败、开关反馈
               这些提示恰恰都发生在设置页里 —— 只写主状态栏等于没说。
               备忘录两个覆盖层当年就是这个待遇（MemoStatus / MemoEditStatus），这里照同一套补一份：
               同样的字号颜色、右 86 避开右下斜线、叠在滚动内容底边之上。 -->
          <TextBlock x:Name="SettingsStatus" Grid.Row="2" VerticalAlignment="Bottom"
                     Margin="16,0,86,10" FontSize="10.5" Foreground="{DynamicResource Ink3}"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
